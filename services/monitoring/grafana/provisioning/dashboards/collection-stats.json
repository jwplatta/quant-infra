{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Totals / Raw Written",
      "description": "Sum of batch byte counts and streaming Level One, order book, and chart stream byte deltas over the selected time range.",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki"
      },
      "targets": [
        {
          "expr": "(sum(sum_over_time({job_name_from_file=~\".+\"} | json | event=~\"fetch_success|file_written|file_rotated\" | unwrap byte_count [$__range])) or vector(0)) + (sum(sum_over_time({job_name_from_file=\"market_streams\"} | json | event=\"stream_bytes_written\" | dataset_type=~\"level_one|order_book|chart_stream\" | unwrap delta_bytes [$__range])) or vector(0))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#D1D5DB"
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Totals / Staging Cache",
