      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\"events_ingestor.*\"} | json | event=\"parquet_written\" | data_type=\"level_one\" | unwrap event_count [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "title": "Order Book Events",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\"events_ingestor.*\"} | json | event=\"parquet_written\" | data_type=\"order_book\" | unwrap event_count [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 10000 }
            ]
          }
        }
      }
    },
    {
      "title": "Total Fetches",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job_name_from_file=~\".+\"} | json | event=\"fetch_success\" [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Failed Fetches",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(count_over_time({job_name_from_file=~\".+\"} | json | event=\"fetch_failed\" [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 10 }
            ]
          }
        }
      }
    },
    {
      "title": "Option Samples by Symbol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 6 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (symbol) (sum_over_time({job_name_from_file=~\".*spx.*|.*option.*|.*etf.*|.*stock.*\"} | json | event=\"fetch_success\" | unwrap row_count [$__range]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Candles by Symbol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 6 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (symbol) (sum_over_time({job_name_from_file=~\".*candle.*|.*futures_candle.*\"} | json | event=\"fetch_success\" | unwrap row_count [$__range]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Level One Events by Symbol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 6 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (symbol) (sum_over_time({job_name_from_file=~\"events_ingestor.*\"} | json | event=\"parquet_written\" | data_type=\"level_one\" | unwrap event_count [$__range]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Order Book Events by Symbol",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 6 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (symbol) (sum_over_time({job_name_from_file=~\"events_ingestor.*\"} | json | event=\"parquet_written\" | data_type=\"order_book\" | unwrap event_count [$__range]))",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "title": "Option Collection Volume",
      "description": "Finalized option-chain CSV bytes collected during the selected range.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 14 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\".*spx.*|.*option.*|.*etf.*|.*stock.*\"} | json | event=\"fetch_success\" | data_type=\"options\" | unwrap byte_count [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Compacted Parquet Added",
      "description": "Net bytes added by finalized option-sample Parquet compaction during the selected range. The scheduled compaction job archives these artifacts to the historical datastore.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 14 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\"compact_all_option_samples.*\"} | json | event=\"parquet_written\" | data_type=\"options\" | compaction_output=\"true\" | unwrap storage_byte_delta [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No compaction",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Compression Ratio (Raw / Parquet)",
      "description": "Option-chain CSV collection bytes divided by net compacted-Parquet bytes added during the selected range. Meaningful after option compaction completes.",
      "type": "stat",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 14 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\".*spx.*|.*option.*|.*etf.*|.*stock.*\"} | json | event=\"fetch_success\" | data_type=\"options\" | unwrap byte_count [$__range])) / sum(sum_over_time({job_name_from_file=~\"compact_all_option_samples.*\"} | json | event=\"parquet_written\" | data_type=\"options\" | compaction_output=\"true\" | unwrap storage_byte_delta [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 2,
          "noValue": "No compaction",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        }
      }
    },
    {
      "title": "Errors",
      "type": "logs",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 20 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "{job_name_from_file=~\".+\"} | json | level=\"ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tickrake", "overview"],
  "templating": { "list": [] },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Collection Stats",
  "uid": "tickrake-collection-stats",
  "version": 1
}
