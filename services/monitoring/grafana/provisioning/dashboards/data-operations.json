{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Log Volume by Job (5m buckets)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum by (job_name_from_file) (count_over_time({job_name_from_file=~\"$job\"}[5m]))", "legendFormat": "{{job_name_from_file}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "title": "Errors by Job (5m buckets)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum by (job_name_from_file) (count_over_time({job_name_from_file=~\"$job\"} | json | level=\"ERROR\" [5m]))", "legendFormat": "{{job_name_from_file}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 20 }, "color": { "mode": "palette-classic" } }, "overrides": [] }
    },
    {
      "title": "Running Support Jobs",
      "description": "Container state for continuously scheduled support jobs.",
      "type": "stat",
      "gridPos": { "h": 5, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "docker_container_up{service=~\"metadata_sync|intraday_publisher|tractatus_publisher\"}", "legendFormat": "{{service}}", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "valueAndName", "orientation": "horizontal" },
      "fieldConfig": { "defaults": { "mappings": [{ "type": "value", "options": { "0": { "text": "Down", "color": "red" }, "1": { "text": "Running", "color": "green" } } }] } }
    },
    {
      "title": "Support Job Errors (24h)",
      "type": "stat",
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 8 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum(count_over_time({job_name_from_file=~\"metadata_sync|intraday_publisher|tractatus_publisher\"} | json | level=\"ERROR\" [24h]))", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "none", "textMode": "value" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 1 }] } } }
    },
    {
      "title": "Tractatus Parquet Bytes Added by Table",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum by (table) (sum_over_time({service=\"tractatus\"} | json | event=\"file_committed\" | unwrap parquet_bytes_added [5m]))", "legendFormat": "{{table}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } }, "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Metadata Sidecars Ingested",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum(sum_over_time({job_name_from_file=\"metadata_sync\"} | json | regexp `metadata_sync: ingested (?P<sidecars>\\d+) sidecar` | unwrap sidecars [5m]))", "legendFormat": "sidecars", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" }, "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Intraday Indexes Published",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "sum(count_over_time({job_name_from_file=\"intraday_publisher\"} |= \"intraday_publisher: published index\" [5m]))", "legendFormat": "indexes", "refId": "A" }],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "bars" }, "color": { "mode": "palette-classic" } } }
    },
    {
      "title": "Support Job Lifecycle and Errors",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 29 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "{job_name_from_file=~\"metadata_sync|intraday_publisher|tractatus_publisher\"} | json | level=\"ERROR\"", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    },
    {
      "title": "Support Job Logs",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 29 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "{job_name_from_file=~\"metadata_sync|intraday_publisher|tractatus_publisher\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    },
    {
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 38 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "{job_name_from_file=~\"$job\"} | json | level=\"ERROR\"", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    },
    {
      "title": "Selected Job Logs",
      "type": "logs",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 38 },
      "datasource": { "type": "loki" },
      "targets": [{ "expr": "{job_name_from_file=~\"$job\"}", "refId": "A" }],
      "options": { "showTime": true, "showLabels": true, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tickrake", "operations", "support-jobs"],
  "templating": {
    "list": [{ "name": "job", "label": "Job", "type": "query", "datasource": { "type": "loki" }, "query": "label_values(job_name_from_file)", "refresh": 2, "includeAll": true, "multi": true, "current": { "text": "All", "value": "$__all" } }]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timezone": "browser",
  "title": "Data Operations",
  "uid": "tickrake-data-operations",
  "version": 1
}
