{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Log Volume by Job (5m buckets)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (job_name_from_file) (count_over_time({job_name_from_file=~\"$job\"}[5m]))",
          "legendFormat": "{{job_name_from_file}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" } },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "title": "Errors by Job (5m buckets)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum by (job_name_from_file) (count_over_time({job_name_from_file=~\"$job\"} | json | level=\"ERROR\" [5m]))",
          "legendFormat": "{{job_name_from_file}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "fillOpacity": 20 },
          "color": { "mode": "palette-classic" }
        },
        "overrides": []
      }
    },
    {
      "title": "Recent Errors",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "{job_name_from_file=~\"$job\"} | json | level=\"ERROR\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "Live Logs",
      "type": "logs",
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "{job_name_from_file=~\"$job\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["tickrake", "overview"],
  "templating": {
    "list": [
      {
        "name": "job",
        "label": "Job",
        "type": "query",
        "datasource": { "type": "loki" },
        "query": "label_values(job_name_from_file)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timezone": "browser",
  "title": "Overview",
  "uid": "tickrake-jobs-overview",
  "version": 4
}
