local.file_match "tickrake" {
  path_targets = [{
    "__path__" = "/var/log/tickrake/*.jsonl",
    "env"     = "prod",
  }]
}

discovery.relabel "tickrake" {
  targets = local.file_match.tickrake.targets

  rule {
    source_labels = ["__path__"]
    regex         = ".*/([^/]+)\\.jsonl"
    target_label  = "job_name_from_file"
    replacement   = "$1"
  }
}

loki.source.file "tickrake" {
  targets       = discovery.relabel.tickrake.output
  tail_from_end = true
  forward_to    = [loki.process.tickrake.receiver]
}

loki.process "tickrake" {
  forward_to = [loki.write.default.receiver]

  stage.json {
    expressions = {
      level    = "level",
      job_name = "job_name",
      job_type = "job_type",
      provider = "provider",
      ts       = "ts",
    }
  }

  stage.labels {
    values = {
      level    = "level",
      job_name = "job_name",
      job_type = "job_type",
      provider = "provider",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }
}

loki.write "default" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
