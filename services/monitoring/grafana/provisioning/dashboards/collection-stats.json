{
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Option Samples",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\".*spx.*|.*option.*|.*etf.*|.*stock.*\"} | json | event=\"fetch_success\" | unwrap row_count [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 10000 },
              { "color": "green", "value": 100000 }
            ]
          }
        }
      }
    },
    {
      "title": "Candles",
      "type": "stat",
      "gridPos": { "h": 6, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "loki" },
      "targets": [
        {
          "expr": "sum(sum_over_time({job_name_from_file=~\".*candle.*|.*futures_candle.*\"} | json | event=\"fetch_success\" | unwrap row_count [$__range]))",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 1000 },
              { "color": "green", "value": 10000 }
            ]
          }
        }
      }
    },
    {
